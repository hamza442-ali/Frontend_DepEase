{
  "name": "depease-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host localhost",
    "start": "vite --host localhost",
    "build": "vite build",
    "preview": "vite preview --host localhost",
    "check": "npm run lint && node scripts/check.mjs",
    "format": "prettier --write src scripts index.html *.config.js package.json",
    "format:check": "prettier --check src scripts index.html *.config.js package.json",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "axios": "^1.13.5",
    "dompurify": "^3.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.0",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "3.6.2",
    "vite": "^8.3.4"
  }
}
